{
  "version": 2,
  "builds": [
    {
      "src": "src/MaxerZ.Web/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist/maxer-z.web/browser"
      }
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
