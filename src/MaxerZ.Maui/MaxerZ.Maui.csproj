<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-maccatalyst</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>MaxerZ.Maui</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name -->
		<ApplicationTitle>MaxerZ</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.majid.maxerz</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0.3</ApplicationDisplayVersion>
		<ApplicationVersion>4</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<ValidateXcodeVersion>false</ValidateXcodeVersion>
		<ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<RunAOTCompilation>false</RunAOTCompilation>
		<UseInterpreter>true</UseInterpreter>
		<MtouchInterpreter>all</MtouchInterpreter>
		<MtouchLink>None</MtouchLink>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<BundleResource Include="Platforms\MacCatalyst\AppIcon.icns" LogicalName="AppIcon.icns" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1A1A2E" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\MaxerZ.Api\MaxerZ.Api.csproj" SetTargetFramework="TargetFramework=net10.0" ExcludeAssets="Analyzers" />
	</ItemGroup>

	<ItemGroup>
		<BundleResource Include="Resources\Templates\**" />
	</ItemGroup>

	<Target Name="RemoveAspNetCoreFrameworkReference" BeforeTargets="ResolveFrameworkReferences">
		<ItemGroup>
			<FrameworkReference Remove="Microsoft.AspNetCore.App" />
		</ItemGroup>
	</Target>

	<Target Name="PublishApiBeforeBuild" BeforeTargets="BeforeBuild">
		<Exec Command="dotnet publish ../MaxerZ.Api/MaxerZ.Api.csproj -c $(Configuration) -r osx-arm64 --self-contained true" />
	</Target>

	<ItemGroup>
		<ReferenceCopyLocalPaths Include="..\MaxerZ.Api\bin\$(Configuration)\net10.0\osx-arm64\publish\*.dll" />
		<ReferenceCopyLocalPaths Include="..\MaxerZ.Api\bin\$(Configuration)\net10.0\osx-arm64\publish\*.dylib" />
		<Content Include="..\MaxerZ.Api\wwwroot\**" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="Always" />
	</ItemGroup>

</Project>
