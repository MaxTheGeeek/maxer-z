    "right": 42
  },
  "header": {
    "enabled": true,
    "imagePath": "header_de.png",
    "height": 100,
    "backgroundColor": "transparent"
  },
  "footer": {
    "enabled": true,
    "imagePath": "footer_de.png",
    "height": 40,
    "backgroundColor": "transparent"
  },
  "contactInformation": {
